[sub_resource type="GDScript" id="GDScript_q7fbv"]
script/source = "class_name Shop extends Control

signal closed

@onready var item_list = $Content/ItemList
@onready var close_button = $Content/CloseButton

func setup(items: Array[ItemData]) -> void:
	_refresh_shop(items)
	_lock_focus_trap()

func _refresh_shop(items: Array[ItemData]) -> void:
	for child in item_list.get_children(): child.queue_free()
	
	for data in items:
		var btn = Button.new()
		btn.text = \"%s 구매 (%d G)\" % [data.name, data.price]
		btn.pressed.connect(_on_buy_pressed.bind(data))
		item_list.add_child(btn)

func _lock_focus_trap() -> void:
	await get_tree().process_frame
	var buttons = []
	for c in item_list.get_children(): if c is Button: buttons.append(c)
	buttons.append(close_button)
	
	if buttons.size() > 0:
		buttons[0].grab_focus()
		buttons[0].focus_neighbor_top = buttons[0].get_path()
		buttons[-1].focus_neighbor_bottom = buttons[-1].get_path()
		for b in buttons:
			b.focus_neighbor_left = b.get_path()
			b.focus_neighbor_right = b.get_path()

func _on_buy_pressed(data: ItemData) -> void:
	# 아이템 구매 및 인벤토리 추가 로직 [cite: 67]
	_lock_focus_trap()

func _on_close_button_pressed() -> void:
	closed.emit()
	queue_free()
"

