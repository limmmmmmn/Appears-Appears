[gd_scene load_steps=5 format=3 uid="uid://bvsfg828vtggy"]

[ext_resource type="Script" uid="uid://byptlrha18jnq" path="res://scenes/ui/village/village.gd" id="1_ntkre"]
[ext_resource type="PackedScene" uid="uid://b3r7ih7jjva0s" path="res://scenes/ui/village/tavern.tscn" id="2_eqehh"]

[sub_resource type="GDScript" id="GDScript_q7fbv"]
script/source = "class_name Village extends Control

@export var tavern_scene: PackedScene 
@export var shop_scene: PackedScene 

@onready var tavern_btn = $MainPanel/TavernButton
@onready var shop_btn = $MainPanel/ShopButton
@onready var main_panel = $MainPanel
@onready var gold_label = $GoldLabel

func _ready() -> void:
	update_gold_ui()
	$MainPanel/TavernButton.grab_focus()

func update_gold_ui() -> void:
	gold_label.text = \"Gold: %d\" % PartyManager.gold

# ✅ 여기가 문제입니다. 이렇게 싹 바꾸세요.
func _on_tavern_button_pressed():
	# 1. 인스턴스화 (load 대신 export 변수 쓰시는 게 더 좋습니다)
	# var tavern_popup = load(\"res://scenes/ui/village/tavern.tscn\").instantiate()
	# tavern_scene이 연결되어 있다면 아래처럼 쓰세요. 연결 안 되어 있으면 기존대로 load 쓰셔도 됩니다.
	var tavern_popup = tavern_scene.instantiate() 
	add_child(tavern_popup)
	
	# ✅ [핵심 해결] 이 줄이 없어서 목록이 안 떴던 겁니다!
	# 태번에게 데이터를 넘겨주고 \"그려라(setup)\"고 명령해야 합니다.
	tavern_popup.setup(PartyManager.get_available_heroes())
	
	# 2. 복잡한 포커스 로직 대신, 만들어두신 공용 함수를 쓰세요.
	# _open_sub_menu가 뒷배경 입력 차단(PROCESS_MODE_DISABLED)을 해주므로 훨씬 안전합니다.
	_open_sub_menu(tavern_popup)

# _on_tavern_closed 함수는 이제 필요 없습니다. 
# (_open_sub_menu 안에서 람다 함수로 처리하고 있으니까요)

# Village.gd 의 _on_shop_button_pressed 수정

func _on_shop_button_pressed() -> void:
	var shop = shop_scene.instantiate()
	add_child(shop)
	
	# [가정] ShopManager나 정적 데이터로 아이템 목록을 가져온다고 가정
	# 테스트용 임시 데이터
	var dummy_items = [
		{ \"name\": \"체력 포션\", \"price\": 50 },
		{ \"name\": \"마나 포션\", \"price\": 80 },
		{ \"name\": \"해독제\", \"price\": 30 },
		{ \"name\": \"롱소드\", \"price\": 500 }
	]
	
	# 데이터 주입! (이게 있어야 리스트가 뜹니다)
	shop.setup(dummy_items) 
	
	# 화면 얼리기 & 포커스 관리 시작
	_open_sub_menu(shop)

func _open_sub_menu(menu: Control) -> void:
	# [철칙] 서브 메뉴가 열리면 마을 패널의 입력을 완전히 차단
	main_panel.process_mode = PROCESS_MODE_DISABLED 
	
	menu.closed.connect(func():
		main_panel.process_mode = PROCESS_MODE_INHERIT # 다시 활성화
		update_gold_ui()
		
		# 닫힌 메뉴가 무엇이었냐에 따라 포커스 복구 위치를 정해주면 더 좋습니다.
		# 일단은 TavernButton으로 복구
		if is_instance_valid(tavern_btn):
			tavern_btn.grab_focus()
	)
"

