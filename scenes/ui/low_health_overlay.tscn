[ext_resource type="Script" path="res://scripts/runtime/low_health_overlay.gd" id="1_overlay"]

[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;

uniform float intensity : hint_range(0.0, 1.0) = 0.0;
uniform vec3 tint_color : source_color = vec3(0.02, 0.02, 0.04);
uniform float vignette_inner : hint_range(0.0, 1.0) = 0.22;
uniform float vignette_outer : hint_range(0.0, 1.0) = 0.7;
uniform float max_alpha : hint_range(0.0, 1.0) = 0.72;

void fragment() {
    // Radial mask: 0 at the screen center, 1 toward the corners.
    float dist = length(UV - vec2(0.5, 0.5));
    float vignette = smoothstep(vignette_inner, vignette_outer, dist);
    COLOR = vec4(tint_color, vignette * intensity * max_alpha);
}
"

